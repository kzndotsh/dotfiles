+// Java AWT is never given an ARGB visual, so it paints tray icons onto an opaque
+// solid background (light gray). When an icon is fully opaque and its four corners
+// share one colour, treat that colour as the background and remove it with
+// colour-to-alpha (the GIMP algorithm), which keeps anti-aliased edges clean.
+static QImage removeSolidBackground(QImage image)
+{
+    if (image.width() < 2 || image.height() < 2) {
+        return image;
+    }
+    image = image.convertToFormat(QImage::Format_ARGB32);
+    const int w = image.width();
+    const int h = image.height();
+    const QRgb bg = image.pixel(0, 0);
+    if (qAlpha(bg) != 255 || image.pixel(w - 1, 0) != bg || image.pixel(0, h - 1) != bg || image.pixel(w - 1, h - 1) != bg) {
+        return image;
+    }
+    for (int y = 0; y < h; ++y) {
+        const auto *line = reinterpret_cast<const QRgb *>(image.constScanLine(y));
+        for (int x = 0; x < w; ++x) {
+            if (qAlpha(line[x]) != 255) {
+                return image; // already has transparency
+            }
+        }
+    }
+
+    const auto channelAlpha = [](int c, int b) -> double {
+        if (c > b) {
+            return (c - b) / double(255 - b);
+        }
+        if (c < b) {
+            return (b - c) / double(b);
+        }
+        return 0.0;
+    };
+    const auto unblend = [](int c, int b, double a) -> int {
+        return std::clamp(int(std::lround((c - b) / a + b)), 0, 255);
+    };
+    const int br = qRed(bg);
+    const int bgr = qGreen(bg);
+    const int bb = qBlue(bg);
+    for (int y = 0; y < h; ++y) {
+        auto *line = reinterpret_cast<QRgb *>(image.scanLine(y));
+        for (int x = 0; x < w; ++x) {
+            const QRgb px = line[x];
+            const double a = std::max({channelAlpha(qRed(px), br), channelAlpha(qGreen(px), bgr), channelAlpha(qBlue(px), bb)});
+            if (a <= 0.0) {
+                line[x] = qRgba(0, 0, 0, 0);
+                continue;
+            }
+            line[x] = qRgba(unblend(qRed(px), br, a), unblend(qGreen(px), bgr, a), unblend(qBlue(px), bb, a), int(std::lround(a * 255)));
+        }
+    }
+    return image;
+}
