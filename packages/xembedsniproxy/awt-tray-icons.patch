+// Innermost viewable descendant of win containing (x, y) (win-relative; rewritten to be
+// relative to the returned window). A real click lands there; AWT only handles tray mouse
+// input on its nested canvas, so a synthetic event sent to the embedded top-level is ignored.
+static xcb_window_t deepestWindowAt(xcb_connection_t *c, xcb_window_t win, int16_t &x, int16_t &y)
+{
+    for (;;) {
+        UniqueCPointer<xcb_query_tree_reply_t> tree(xcb_query_tree_reply(c, xcb_query_tree(c, win), nullptr));
+        if (!tree) {
+            return win;
+        }
+        const xcb_window_t *children = xcb_query_tree_children(tree.get());
+        xcb_window_t next = XCB_WINDOW_NONE;
+        // children are bottom-to-top; check topmost first
+        for (int i = xcb_query_tree_children_length(tree.get()) - 1; i >= 0; --i) {
+            UniqueCPointer<xcb_get_window_attributes_reply_t> attrs(
+                xcb_get_window_attributes_reply(c, xcb_get_window_attributes(c, children[i]), nullptr));
+            if (!attrs || attrs->map_state != XCB_MAP_STATE_VIEWABLE || attrs->_class != XCB_WINDOW_CLASS_INPUT_OUTPUT) {
+                continue;
+            }
+            UniqueCPointer<xcb_get_geometry_reply_t> geom(xcb_get_geometry_reply(c, xcb_get_geometry(c, children[i]), nullptr));
+            if (geom && x >= geom->x && y >= geom->y && x < geom->x + geom->width && y < geom->y + geom->height) {
+                x -= geom->x;
+                y -= geom->y;
+                next = children[i];
+                break;
+            }
+        }
+        if (next == XCB_WINDOW_NONE) {
+            return win;
+        }
+        win = next;
+    }
+}
