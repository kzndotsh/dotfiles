# OpenTofu / Terranix. Copy to `.env.kzn`.
#   nix run .#vps-plan
HCLOUD_TOKEN=
CLOUDFLARE_API_TOKEN=
TF_VAR_cloudflare_zone_id=
# Named tunnels (kiro, files, crew). Token needs Cloudflare Tunnel:Edit.
TF_VAR_cloudflare_account_id=
# Cloudflare Access on crew.kzn.sh (Kiro Crew). Token also needs Access: Apps and Policies:Edit.
TF_VAR_crew_access_emails='["you@example.com"]'
